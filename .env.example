# ---------------------------------------------------------------------------
# Copy to the relevant location and fill in. Never commit real values.
#   apps/companion/.env      -> EXPO_PUBLIC_* only
#   apps/caregiver/.env      -> EXPO_PUBLIC_* only
#   services/voice-agent/.env.local
#   supabase secrets set ... (for Edge Functions)
# ---------------------------------------------------------------------------

# --- Supabase (public, safe in mobile apps) ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Supabase (server side only) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- LiveKit Cloud ---
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=...
# Name the agent worker registers with; the token function dispatches to it.
LIVEKIT_AGENT_NAME=care-companion

# --- OpenAI ---
OPENAI_API_KEY=sk-...
# Realtime speech-to-speech model used by the voice agent.
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
# Text model used for nightly summaries and end-of-session notes.
SUMMARY_MODEL=gpt-5-mini

# --- Voice agent behaviour ---
# How long the agent waits for a caregiver reply before speaking the fallback (seconds).
CONTACT_REQUEST_TIMEOUT_SECONDS=90
# Base URL for Edge Functions the agent calls (notify-request).
SUPABASE_FUNCTIONS_URL=https://YOUR-PROJECT.supabase.co/functions/v1

# --- Summaries ---
# IANA time zone used when deciding which day a session belongs to.
SUMMARY_TIMEZONE=Australia/Sydney
